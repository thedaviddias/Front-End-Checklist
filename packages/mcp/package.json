{
  "name": "@repo/mcp",
  "version": "0.0.1",
  "private": true,
  "description": "MCP server exposing Front-End Checklist rules to AI agents",
  "exports": {
    ".": "./src/index.ts",
    "./load-rules": "./src/load-rules.ts",
    "./tools": "./src/tools/index.ts",
    "./content-loader": "./src/content-loader.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "conformance": "tsx scripts/conformance.ts",
    "eval:tools": "tsx scripts/eval-tool-choice.ts",
    "evaluate": "jest tests/quality --runInBand",
    "lint": "biome check .",
    "load": "tsx scripts/load-test.ts",
    "serve": "tsx scripts/serve.ts",
    "test": "jest",
    "test:ci": "jest --ci --runInBand --passWithNoTests",
    "test:coverage": "jest --coverage --ci --passWithNoTests",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@frontendchecklist/rules": "workspace:*",
    "@modelcontextprotocol/server": "^2.3.0",
    "@repo/config": "workspace:*",
    "@repo/types": "workspace:*",
    "node-html-parser": "^9.0.4",
    "undici": "^7.30.0",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/client": "^2.3.0",
    "@repo/config-typescript": "workspace:^",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "jest": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:"
  }
}
